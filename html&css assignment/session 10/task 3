<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookMyShow - Featured Movies Carousel</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #0f1017;
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        /* Carousel Outer Wrapper */
        .bms-carousel-container {
            max-width: 1200px;
            margin: 0 auto;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
        }

        .carousel-item {
            height: 440px;
            background-color: #1a1a24;
        }

        .carousel-item img {
            height: 100%;
            width: 100%;
            object-fit: cover;
            filter: brightness(0.85);
        }

        /* Dark Gradient Overlay for Caption */
        .carousel-caption-overlay {
            background: linear-gradient(0deg, rgba(15, 16, 23, 0.95) 0%, rgba(15, 16, 23, 0.6) 60%, rgba(15, 16, 23, 0) 100%);
            left: 0;
            right: 0;
            bottom: 0;
            padding: 40px 30px 24px 30px;
            text-align: left;
        }

        /* Badges & Text Styling */
        .badge-genre {
            background-color: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(4px);
            font-size: 12px;
            font-weight: 500;
            padding: 4px 10px;
            border-radius: 4px;
        }

        .btn-bms-red {
            background-color: #f84464; /* BookMyShow Primary Red */
            color: #ffffff;
            font-weight: 700;
            font-size: 14px;
            padding: 8px 24px;
            border-radius: 6px;
            border: none;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .btn-bms-red:hover {
            background-color: #d83350;
            color: #ffffff;
            transform: translateY(-2px);
        }

        /* Custom Indicators */
        .carousel-indicators [data-bs-target] {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #ffffff;
            opacity: 0.5;
            margin: 0 5px;
        }

        .carousel-indicators .active {
            opacity: 1;
            background-color: #f84464;
            width: 24px;
            border-radius: 5px;
        }
    </style>
</head>
<body>

    <main class="container my-5">
        <h2 class="h4 fw-bold text-white mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-film text-danger"></i>
            <span>Recommended Movies</span>
        </h2>

        <!-- BOOTSTRAP CAROUSEL CONTAINER -->
        <div class="bms-carousel-container">
            <div id="movieFeaturedCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
                
                <!-- Indicators / Slide Dots -->
                <div class="carousel-indicators mb-3">
                    <button type="button" data-bs-target="#movieFeaturedCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#movieFeaturedCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#movieFeaturedCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>

                <!-- Carousel Slides -->
                <div class="carousel-inner">

                    <!-- Movie Slide 1 -->
                    <div class="carousel-item active" data-bs-interval="4000">
                        <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=1200" alt="Inception Banner">
                        <div class="carousel-caption carousel-caption-overlay">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge-genre">Sci-Fi / Action</span>
                                <span class="text-warning small d-flex align-items-center gap-1">
                                    <i class="bi bi-star-fill"></i> 8.8/10 (240K Votes)
                                </span>
                            </div>
                            <h3 class="h2 fw-bold mb-1">Inception</h3>
                            <p class="small text-light-50 mb-3 d-none d-md-block" style="max-width: 600px;">
                                A thief who steals corporate secrets through dream-sharing technology is given the inverse task of planting an idea into the mind of a C.E.O.
                            </p>
                            <button class="btn btn-bms-red d-inline-flex align-items-center gap-2">
                                <i class="bi bi-ticket-perforated-fill"></i> Book Tickets
                            </button>
                        </div>
                    </div>

                    <!-- Movie Slide 2 -->
                    <div class="carousel-item" data-bs-interval="4000">
                        <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1200" alt="Dune Banner">
                        <div class="carousel-caption carousel-caption-overlay">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge-genre">Adventure / Sci-Fi</span>
                                <span class="text-warning small d-flex align-items-center gap-1">
                                    <i class="bi bi-star-fill"></i> 8.5/10 (180K Votes)
                                </span>
                            </div>
                            <h3 class="h2 fw-bold mb-1">Dune: Part Two</h3>
                            <p class="small text-light-50 mb-3 d-none d-md-block" style="max-width: 600px;">
                                Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family.
                            </p>
                            <button class="btn btn-bms-red d-inline-flex align-items-center gap-2">
                                <i class="bi bi-ticket-perforated-fill"></i> Book Tickets
                            </button>
                        </div>
                    </div>

                    <!-- Movie Slide 3 -->
                    <div class="carousel-item" data-bs-interval="4000">
                        <img src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=1200" alt="Interstellar Banner">
                        <div class="carousel-caption carousel-caption-overlay">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge-genre">Drama / Sci-Fi</span>
                                <span class="text-warning small d-flex align-items-center gap-1">
                                    <i class="bi bi-star-fill"></i> 8.7/10 (310K Votes)
                                </span>
                            </div>
                            <h3 class="h2 fw-bold mb-1">Interstellar</h3>
                            <p class="small text-light-50 mb-3 d-none d-md-block" style="max-width: 600px;">
                                When Earth becomes uninhabitable in the future, a farmer and ex-NASA pilot is tasked to pilot a spacecraft through a wormhole to find a new planet.
                            </p>
                            <button class="btn btn-bms-red d-inline-flex align-items-center gap-2">
                                <i class="bi bi-ticket-perforated-fill"></i> Book Tickets
                            </button>
                        </div>
                    </div>

                </div>

                <!-- Left & Right Arrow Controls -->
                <button class="carousel-control-prev" type="button" data-bs-target="#movieFeaturedCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#movieFeaturedCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>

            </div>
        </div>
    </main>

    <!-- Bootstrap 5.3 JS Bundle (Required for Carousel Cycling & Slide Controls) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>