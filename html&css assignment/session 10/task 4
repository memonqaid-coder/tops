<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zomato Style Restaurant Review Form</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f8f8;
            font-family: Okra, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1c1c1c;
        }

        /* Review Card Container */
        .review-card {
            background-color: #ffffff;
            border: 1px solid #e8e8e8;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            max-width: 580px;
            margin: 0 auto;
        }

        /* Form Control Focus Styles */
        .form-control:focus {
            border-color: #e23744;
            box-shadow: 0 0 0 0.2rem rgba(226, 55, 68, 0.15);
        }

        /* Interactive Star Rating Styling */
        .star-rating-group {
            display: inline-flex;
            flex-direction: row-reverse;
            gap: 6px;
        }

        .star-rating-group input[type="radio"] {
            display: none;
        }

        .star-rating-group label {
            font-size: 28px;
            color: #d4d4d4;
            cursor: pointer;
            transition: color 0.15s ease, transform 0.15s ease;
        }

        /* Hover & Checked state logic (using flex-direction: row-reverse) */
        .star-rating-group label:hover,
        .star-rating-group label:hover ~ label,
        .star-rating-group input[type="radio"]:checked ~ label {
            color: #ef4f5f;
        }

        .star-rating-group label:hover {
            transform: scale(1.15);
        }

        /* Zomato Red Primary Button */
        .btn-zomato {
            background-color: #e23744;
            color: #ffffff;
            font-weight: 600;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            padding: 12px 0;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .btn-zomato:hover {
            background-color: #d12b38;
            color: #ffffff;
        }

        .btn-zomato:active {
            transform: scale(0.99);
        }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="review-card p-4 p-md-5">
            
            <!-- Header -->
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-chat-left-heart-fill fs-3 text-danger"></i>
                <h3 class="fw-bold m-0">Write a Review</h3>
            </div>
            <p class="text-muted small mb-4">Share your dining experience with food lovers in your city.</p>

            <!-- Review Form -->
            <form action="#" method="POST" id="zomatoReviewForm">
                
                <!-- Field 1: User Name -->
                <div class="mb-3">
                    <label for="userName" class="form-label fw-semibold small text-uppercase text-secondary">Your Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-person"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" id="userName" name="userName" placeholder="e.g. Rahul Sharma" required>
                    </div>
                </div>

                <!-- Field 2: Interactive Star Rating (1-5) -->
                <div class="mb-4">
                    <label class="form-label d-block fw-semibold small text-uppercase text-secondary mb-1">Overall Rating</label>
                    <div class="star-rating-group" id="starRating">
                        <input type="radio" id="star5" name="rating" value="5" required>
                        <label for="star5" title="5 Stars - Exceptional"><i class="bi bi-star-fill"></i></label>

                        <input type="radio" id="star4" name="rating" value="4">
                        <label for="star4" title="4 Stars - Great"><i class="bi bi-star-fill"></i></label>

                        <input type="radio" id="star3" name="rating" value="3">
                        <label for="star3" title="3 Stars - Average"><i class="bi bi-star-fill"></i></label>

                        <input type="radio" id="star2" name="rating" value="2">
                        <label for="star2" title="2 Stars - Poor"><i class="bi bi-star-fill"></i></label>

                        <input type="radio" id="star1" name="rating" value="1">
                        <label for="star1" title="1 Star - Terrible"><i class="bi bi-star-fill"></i></label>
                    </div>
                </div>

                <!-- Field 3: Review Message -->
                <div class="mb-4">
                    <label for="reviewMessage" class="form-label fw-semibold small text-uppercase text-secondary">Your Experience</label>
                    <textarea class="form-control" id="reviewMessage" name="reviewMessage" rows="4" placeholder="How was the food, ambiance, and service? Mention your favorite dishes..." minlength="10" required></textarea>
                    <div class="form-text text-end small">Minimum 10 characters</div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-zomato w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-send-fill fs-6"></i>
                    <span>Submit Review</span>
                </button>

            </form>

        </div>
    </div>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"></script>
</body>
</html>